# ─────────────────────────────────────────────────────────────────────────────
# Inxora Content Engine Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Target Inxora Studio API
# Target Inxora Studio Webhook Endpoint
INXORA_API_URL="http://localhost:3000/api/webhooks/content-ingest"
CONTENT_INGEST_SECRET="inxora-content-ingest-secret-2026-secure"

# AI Model Configuration (Optional Gemini API key for external LLM inference)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"
# ─────────────────────────────────────────────────────────────────────────────
# Universal AI Orchestra & Custom Endpoint Configuration
# Compatible with: OpenAI, DeepSeek, OpenRouter, Groq, Ollama, vLLM
# ─────────────────────────────────────────────────────────────────────────────

# 1. API Key provider pilihan Anda (DeepSeek, OpenRouter, OpenAI, Groq, dll)
AI_API_KEY=""

# 2. Custom Endpoint URL
# Contoh:
# - DeepSeek:    https://api.deepseek.com/chat/completions
# - OpenRouter:  https://openrouter.ai/api/v1/chat/completions
# - OpenAI:      https://api.openai.com/v1/chat/completions
# - Groq:        https://api.groq.com/openai/v1/chat/completions
# - Ollama Local:http://localhost:11434/v1/chat/completions
AI_ENDPOINT="https://router.inxorastudio.com/v1=chat/completions"

# 3. Default AI Model (digunakan jika model per-role tidak diset)
AI_MODEL="deepseek-chat"

# 4. Multi-Agent Role Model Overrides (Opsional: untuk Combo AI khusus)
# Stage 1: Architect (Cocok untuk reasoning model: deepseek-reasoner, o3-mini)
AI_MODEL_ARCHITECT="deepseek-reasoner"

# Stage 2: Senior Writer (Cocok untuk model penulisan fasih: deepseek-chat, claude-3.5-sonnet)
AI_MODEL_WRITER="deepseek-chat"

# Stage 3: Reviewer & Anti-Slop Auditor (Cocok untuk fast strict auditor: deepseek-chat, gpt-4o-mini)
AI_MODEL_REVIEWER="deepseek-chat"
